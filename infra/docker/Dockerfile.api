# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
RUN apk add --no-cache openssl wget && corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile=false \
  && pnpm --filter @synchem-sfa/shared-types build \
  && pnpm --filter @synchem-sfa/shared-i18n build \
  && pnpm --filter @synchem-sfa/api exec prisma generate \
  && pnpm --filter @synchem-sfa/api build

FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl wget && corepack enable
WORKDIR /app

ENV NODE_ENV=production

# Copy the full install tree — pnpm symlinks break if node_modules is copied piecemeal.
COPY --from=build /app /app

WORKDIR /app/apps/api
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm start:prod"]
