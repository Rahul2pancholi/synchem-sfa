        <mxCell id="4" value="End-to-end path: browser → login → JWT → role dashboard → daily SFA work." style="text;html=1;strokeColor=none;fillColor=#f0f4ff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#333333;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="580" height="36" as="geometry"/></mxCell>
