▸ Data
  authorizationData, menusData, employeeData" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="290" y="448" width="330" height="108" as="geometry"/></mxCell>
