{
  "name": "synchem-sfa",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant Pharma SFA SaaS platform",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @synchem-sfa/api dev",
    "dev:web": "pnpm --filter @synchem-sfa/web dev",
    "dev:mobile": "pnpm --filter @synchem-sfa/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docker:dev": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    "colima:start": "colima start --cpu 2 --memory 4",
    "colima:stop": "colima stop",
    "colima:status": "colima status",
    "setup:local": "colima start --cpu 2 --memory 4 && docker-compose -f infra/docker/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @synchem-sfa/api prisma:migrate",
    "db:seed": "pnpm --filter @synchem-sfa/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
