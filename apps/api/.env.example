# Copy to apps/api/.env.local for local development
APP_ENV=dev
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sfa:sfa_dev_password@localhost:5432/synchem_sfa
# Docker Compose uses host port 5434 — use 5432 for Homebrew Postgres
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32-char-minimum-secret-key!!
JWT_EXPIRES_IN=12h
LOG_LEVEL=debug
SEED_ADMIN_PASSWORD=Admin@123
SEED_PLATFORM_PASSWORD=Platform@123
# Shared with insights-service for runtime config fetch (local dev)
INTERNAL_API_KEY=dev-internal-key-change-me
