  claimMonth    Int       @map("claim_month")
  claimYear     Int       @map("claim_year")
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  approveStatus String    @default("DRAFT") @map("approve_status") @db.VarChar(20)
  version       Int       @default(1)
  submittedAt   DateTime? @map("submitted_at")
