// Prisma schema v1 — SFA Platform (draft)
// Generator & datasource — update DATABASE_URL per environment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PLATFORM & TENANT
// =============================================================================

model Company {
  compCode     String   @id @map("comp_code") @db.VarChar(10)
  compName     String   @map("comp_name") @db.VarChar(255)
  compAddress  String?  @map("comp_address") @db.Text
  industryType String   @default("SYN") @map("industry_type") @db.VarChar(20)
  timezone     String   @default("Asia/Kolkata") @db.VarChar(50)
  locale       String   @default("en-IN") @db.VarChar(10)
  logoPath     String?  @map("logo_path") @db.VarChar(500)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  settings     CompanySetting[]
  employees    Employee[]
  roles        Role[]
  hierarchies  Hierarchy[]
  states       State[]
  headquarters HeadQuarter[]
  doctors      Doctor[]
  retailers    Retailer[]
  stockists    Stockist[]
  products     Product[]
  brands       Brand[]
  divisions    ProductDivision[]
  designations Designation[]
  dosages      Dosage[]
  specialists  Specialist[]
  qualifications Qualification[]
  holidays     Holiday[]
  expenseHeads ExpenseHead[]
  expenseTemplates ExpenseTemplate[]
  leavePolicies LeavePolicy[]
  syncBatches  SyncBatch[]

  @@map("companies")
}

model CompanySetting {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  settingKey String  @map("setting_key") @db.VarChar(20) // SET001–SET131
  settingValue String @map("setting_value") @db.Text
  dataType  String   @default("string") @map("data_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])

  @@unique([compCode, settingKey])
  @@index([compCode])
  @@map("company_settings")
}

model PlatformUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_users")
}

// =============================================================================
// AUTH & RBAC
// =============================================================================

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  roleName  String   @map("role_name") @db.VarChar(100)
  roleType  String   @map("role_type") @db.VarChar(10) // AD, MAN, FS
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [compCode], references: [compCode])
  employees   Employee[]
  permissions RoleMenuPermission[]

  @@unique([compCode, roleName])
  @@index([compCode])
  @@map("roles")
}

model Menu {
  id            String   @id @default(uuid()) @db.Uuid
  menuCode      String   @unique @map("menu_code") @db.VarChar(20)
  menuName      String   @map("menu_name") @db.VarChar(255)
  menuUrl       String?  @map("menu_url") @db.VarChar(500)
  menuType      String?  @map("menu_type") @db.VarChar(10)
  parentMenuId  String?  @map("parent_menu_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  parent       Menu?                @relation("MenuTree", fields: [parentMenuId], references: [id])
  children     Menu[]               @relation("MenuTree")
  permissions  RoleMenuPermission[]

  @@map("menus")
}

model RoleMenuPermission {
  id         String  @id @default(uuid()) @db.Uuid
  compCode   String  @map("comp_code") @db.VarChar(10)
  roleId     String  @map("role_id") @db.Uuid
  menuId     String  @map("menu_id") @db.Uuid
  canView    Boolean @default(false) @map("can_view")
  canAdd     Boolean @default(false) @map("can_add")
  canEdit    Boolean @default(false) @map("can_edit")
  canDelete  Boolean @default(false) @map("can_delete")
  canPreview Boolean @default(false) @map("can_preview")
  canPrint   Boolean @default(false) @map("can_print")

  role Role @relation(fields: [roleId], references: [id])
  menu Menu @relation(fields: [menuId], references: [id])

  @@unique([compCode, roleId, menuId])
  @@index([compCode, roleId])
  @@map("role_menu_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  empId     String   @map("emp_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [empId], references: [id])

  @@index([compCode, empId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// =============================================================================
// ORG & EMPLOYEE
// =============================================================================

model Hierarchy {
  id                  String   @id @default(uuid()) @db.Uuid
  compCode            String   @map("comp_code") @db.VarChar(10)
  hierarchyCode       String   @map("hierarchy_code") @db.VarChar(50)
  hierarchyType       String   @map("hierarchy_type") @db.VarChar(20)
  hierarchyLevel      Int      @map("hierarchy_level")
  reportingHierarchyId String? @map("reporting_hierarchy_id") @db.Uuid
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [compCode], references: [compCode])
  employees  Employee[]
  parent     Hierarchy?  @relation("HierarchyTree", fields: [reportingHierarchyId], references: [id])
  children   Hierarchy[] @relation("HierarchyTree")

  @@unique([compCode, hierarchyCode])
  @@index([compCode])
  @@map("hierarchies")
}

model Employee {
  id                   String    @id @default(uuid()) @db.Uuid
  compCode             String    @map("comp_code") @db.VarChar(10)
  userName             String    @map("user_name") @db.VarChar(100)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  employeeCode         String?   @map("employee_code") @db.VarChar(20)
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String?   @map("last_name") @db.VarChar(100)
  email                String?   @db.VarChar(255)
  mobileNo             String?   @map("mobile_no") @db.VarChar(20)
  roleId               String    @map("role_id") @db.Uuid
  hierarchyId          String?   @map("hierarchy_id") @db.Uuid
  headQuarterId        String?   @map("head_quarter_id") @db.Uuid
  reportingManagerId   String?   @map("reporting_manager_id") @db.Uuid
  divisionId           String?   @map("division_id") @db.Uuid
  mpinHash             String?   @map("mpin_hash") @db.VarChar(255)
  isFirstLogin         Boolean   @default(true) @map("is_first_login")
  isCheckInEnabled     Boolean   @default(false) @map("is_check_in_enabled")
  isGeoFencingEnabled  Boolean   @default(false) @map("is_geo_fencing_enabled")
  pushToken            String?   @map("push_token") @db.VarChar(500)
  active               Boolean   @default(true)
  lastLoginAt          DateTime? @map("last_login_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  company          Company        @relation(fields: [compCode], references: [compCode])
  role             Role           @relation(fields: [roleId], references: [id])
  hierarchy        Hierarchy?     @relation(fields: [hierarchyId], references: [id])
  headQuarter      HeadQuarter?   @relation(fields: [headQuarterId], references: [id])
  division         ProductDivision? @relation(fields: [divisionId], references: [id])
  reportingManager Employee?      @relation("EmployeeReportsTo", fields: [reportingManagerId], references: [id])
  directReports    Employee[]     @relation("EmployeeReportsTo")
  refreshTokens    RefreshToken[]
  dailyCallReports DailyCallReport[]
  tourProgrammes   TourProgramme[]
  weeklyPlans      WeeklyPlan[]
  personalOrders   PersonalOrderBooking[]
  leaveApplications LeaveApplication[]
  leaveBalances    LeaveBalance[]
  expenseStatements ExpenseStatement[]
  syncBatches      SyncBatch[]
  gpsCheckIns      GpsCheckIn[]
  auditLogs        AuditLog[]

  @@unique([compCode, userName])
  @@index([compCode, headQuarterId])
  @@index([compCode, roleId])
  @@map("employees")
}

// =============================================================================
// GEOGRAPHY & TERRITORY
// =============================================================================

model State {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  stateName String   @map("state_name") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])
  cities  City[]
  headquarters HeadQuarter[]

  @@unique([compCode, stateName])
  @@index([compCode])
  @@map("states")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  stateId   String   @map("state_id") @db.Uuid
  cityName  String   @map("city_name") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state State @relation(fields: [stateId], references: [id])

  @@unique([compCode, stateId, cityName])
  @@index([compCode])
  @@map("cities")
}

model HeadQuarter {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  hqName    String   @map("hq_name") @db.VarChar(100)
  stateId   String?  @map("state_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company   Company    @relation(fields: [compCode], references: [compCode])
  state     State?     @relation(fields: [stateId], references: [id])
  employees Employee[]
  routes    Route[]

  @@unique([compCode, hqName])
  @@index([compCode])
  @@map("head_quarters")
}

model Route {
  id            String   @id @default(uuid()) @db.Uuid
  compCode      String   @map("comp_code") @db.VarChar(10)
  headQuarterId String   @map("head_quarter_id") @db.Uuid
  routeName     String   @map("route_name") @db.VarChar(100)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  headQuarter HeadQuarter @relation(fields: [headQuarterId], references: [id])
  doctors     Doctor[]
  retailers   Retailer[]
  stockists   Stockist[]

  @@unique([compCode, headQuarterId, routeName])
  @@index([compCode, headQuarterId])
  @@map("routes")
}

// =============================================================================
// LOOKUP MASTERS (Phase 1)
// =============================================================================

model ProductDivision {
  id           String   @id @default(uuid()) @db.Uuid
  compCode     String   @map("comp_code") @db.VarChar(10)
  divisionName String   @map("division_name") @db.VarChar(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [compCode], references: [compCode])
  employees Employee[]
  products  Product[]

  @@unique([compCode, divisionName])
  @@index([compCode])
  @@map("product_divisions")
}

model Designation {
  id              String   @id @default(uuid()) @db.Uuid
  compCode        String   @map("comp_code") @db.VarChar(10)
  designationName String   @map("designation_name") @db.VarChar(100)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])

  @@unique([compCode, designationName])
  @@index([compCode])
  @@map("designations")
}

model Dosage {
  id         String   @id @default(uuid()) @db.Uuid
  compCode   String   @map("comp_code") @db.VarChar(10)
  dosageName String   @map("dosage_name") @db.VarChar(100)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])

  @@unique([compCode, dosageName])
  @@index([compCode])
  @@map("dosages")
}

model Specialist {
  id             String   @id @default(uuid()) @db.Uuid
  compCode       String   @map("comp_code") @db.VarChar(10)
  specialistName String   @map("specialist_name") @db.VarChar(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])
  doctors Doctor[]

  @@unique([compCode, specialistName])
  @@index([compCode])
  @@map("specialists")
}

model Qualification {
  id                String   @id @default(uuid()) @db.Uuid
  compCode          String   @map("comp_code") @db.VarChar(10)
  qualificationName String   @map("qualification_name") @db.VarChar(100)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])
  doctors Doctor[]

  @@unique([compCode, qualificationName])
  @@index([compCode])
  @@map("qualifications")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  compCode    String   @map("comp_code") @db.VarChar(10)
  holidayName String   @map("holiday_name") @db.VarChar(100)
  holidayDate DateTime @map("holiday_date") @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])

  @@unique([compCode, holidayDate, holidayName])
  @@index([compCode])
  @@map("holidays")
}

model ExpenseHead {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  headName  String   @map("head_name") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])
  lines   ExpenseStatementLine[]

  @@unique([compCode, headName])
  @@index([compCode])
  @@map("expense_heads")
}

model ExpenseTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  compCode     String   @map("comp_code") @db.VarChar(10)
  templateName String   @map("template_name") @db.VarChar(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])

  @@unique([compCode, templateName])
  @@index([compCode])
  @@map("expense_templates")
}

model Stockist {
  id           String    @id @default(uuid()) @db.Uuid
  compCode     String    @map("comp_code") @db.VarChar(10)
  routeId      String?   @map("route_id") @db.Uuid
  stockistName String    @map("stockist_name") @db.VarChar(255)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company Company @relation(fields: [compCode], references: [compCode])
  route   Route?  @relation(fields: [routeId], references: [id])

  @@index([compCode, routeId])
  @@map("stockists")
}

// =============================================================================
// MASTERS — CUSTOMERS & PRODUCTS (v1 core)
// =============================================================================

model Doctor {
  id            String    @id @default(uuid()) @db.Uuid
  compCode      String    @map("comp_code") @db.VarChar(10)
  routeId       String?   @map("route_id") @db.Uuid
  doctorName    String    @map("doctor_name") @db.VarChar(255)
  specialistId  String?   @map("specialist_id") @db.Uuid
  qualificationId String? @map("qualification_id") @db.Uuid
  mobileNo      String?   @map("mobile_no") @db.VarChar(20)
  approveStatus String    @default("APPROVED") @map("approve_status") @db.VarChar(20)
  active        Boolean   @default(true)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company       Company        @relation(fields: [compCode], references: [compCode])
  route         Route?         @relation(fields: [routeId], references: [id])
  specialist    Specialist?    @relation(fields: [specialistId], references: [id])
  qualification Qualification? @relation(fields: [qualificationId], references: [id])

  @@index([compCode, routeId])
  @@map("doctors")
}

model Retailer {
  id            String    @id @default(uuid()) @db.Uuid
  compCode      String    @map("comp_code") @db.VarChar(10)
  routeId       String?   @map("route_id") @db.Uuid
  retailerName  String    @map("retailer_name") @db.VarChar(255)
  approveStatus String    @default("APPROVED") @map("approve_status") @db.VarChar(20)
  active        Boolean   @default(true)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company Company @relation(fields: [compCode], references: [compCode])
  route   Route?  @relation(fields: [routeId], references: [id])

  @@index([compCode, routeId])
  @@map("retailers")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  brandName String   @map("brand_name") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [compCode], references: [compCode])
  products Product[]

  @@unique([compCode, brandName])
  @@index([compCode])
  @@map("brands")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  compCode    String   @map("comp_code") @db.VarChar(10)
  brandId     String?  @map("brand_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(255)
  productCode String?  @map("product_code") @db.VarChar(50)
  divisionId  String?  @map("division_id") @db.Uuid
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company  Company          @relation(fields: [compCode], references: [compCode])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  division ProductDivision? @relation(fields: [divisionId], references: [id])

  @@unique([compCode, productCode])
  @@index([compCode])
  @@map("products")
}

// =============================================================================
// TRANSACTIONS — DCR (v1 core)
// =============================================================================

model DailyCallReport {
  id             String    @id @default(uuid()) @db.Uuid
  compCode       String    @map("comp_code") @db.VarChar(10)
  empId          String    @map("emp_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid // mobile idempotency
  workDate       DateTime  @map("work_date") @db.Date
  headQuarterId  String?   @map("head_quarter_id") @db.Uuid
  routeId        String?   @map("route_id") @db.Uuid
  approveStatus  String    @default("DRAFT") @map("approve_status") @db.VarChar(20)
  version        Int       @default(1)
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee      Employee           @relation(fields: [empId], references: [id])
  doctorVisits  DcrDoctorVisit[]
  retailerVisits DcrRetailerVisit[]

  @@unique([compCode, clientId])
  @@index([compCode, empId, workDate])
  @@map("daily_call_reports")
}

model DcrDoctorVisit {
  id        String   @id @default(uuid()) @db.Uuid
  compCode  String   @map("comp_code") @db.VarChar(10)
  dcrId     String   @map("dcr_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  visitOrder Int     @default(0) @map("visit_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dcr DailyCallReport @relation(fields: [dcrId], references: [id])

  @@unique([compCode, clientId])
  @@index([compCode, dcrId])
  @@map("dcr_doctor_visits")
}

model DcrRetailerVisit {
  id         String   @id @default(uuid()) @db.Uuid
  compCode   String   @map("comp_code") @db.VarChar(10)
  dcrId      String   @map("dcr_id") @db.Uuid
  retailerId String   @map("retailer_id") @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  visitOrder Int      @default(0) @map("visit_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  dcr DailyCallReport @relation(fields: [dcrId], references: [id])

  @@unique([compCode, clientId])
  @@index([compCode, dcrId])
  @@map("dcr_retailer_visits")
}

model TourProgramme {
  id            String    @id @default(uuid()) @db.Uuid
  compCode      String    @map("comp_code") @db.VarChar(10)
  empId         String    @map("emp_id") @db.Uuid
  planMonth     Int       @map("plan_month")
  planYear      Int       @map("plan_year")
  approveStatus String    @default("DRAFT") @map("approve_status") @db.VarChar(20)
  version       Int       @default(1)
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee Employee           @relation(fields: [empId], references: [id])
  days     TourProgrammeDay[]

  @@unique([compCode, empId, planMonth, planYear])
  @@index([compCode, empId])
  @@map("tour_programmes")
}

model TourProgrammeDay {
  id              String   @id @default(uuid()) @db.Uuid
  compCode        String   @map("comp_code") @db.VarChar(10)
  tourProgrammeId String   @map("tour_programme_id") @db.Uuid
  dayOfMonth      Int      @map("day_of_month")
  routeId         String?  @map("route_id") @db.Uuid
  workType        String   @default("FIELD") @map("work_type") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tourProgramme TourProgramme @relation(fields: [tourProgrammeId], references: [id], onDelete: Cascade)

  @@unique([tourProgrammeId, dayOfMonth])
